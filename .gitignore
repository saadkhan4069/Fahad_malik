# Laravel Environment Files
.env
.env.backup
.env.production
.env.local
.env.*.local

# Laravel Storage - Sessions, Logs, Cache
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Laravel Uploaded Files and Generated Content
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/app/labels/*
!/storage/app/labels/.gitkeep

# Public Storage Symlink Contents
/public/storage
/public_html/storage

# Database Dumps and Backups
*.sql
*.sql.gz
*.dump

# Composer
composer.phar
/vendor/

# IDE and Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

